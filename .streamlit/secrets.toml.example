# Streamlit Cloud Secrets - 複製呢個 file 做 secrets.toml（本地測試用）
# 部署上 Streamlit Cloud 嘅話，喺 dashboard 入 secrets
#
# ============================================================
# Prod 同 UAT 應該有兩套 secrets
# Prod app  : ENV 留空（或設 "production"）
# UAT  app  : ENV = "uat"  ←  會 trigger 頂部黃色 banner
# ============================================================

# Environment flag (只有 UAT app 要設)
# ENV = "uat"

# Gemini API
GEMINI_API_KEY = "AIzaSy..."

# Supabase
# ⚠️ Prod 同 UAT 要用唔同 project，唔好 share，否則測試數據會污染正式 user
SUPABASE_URL = "https://你個project.supabase.co"
SUPABASE_ANON_KEY = "eyJhbGc...你個anon key"

# Stripe
# ⚠️ Prod 用 live keys (sk_live_...), UAT 用 test keys (sk_test_...)
# Stripe dashboard 切到 test mode 攞 test keys + 建 test price IDs
STRIPE_SECRET_KEY = "sk_live_..."
STRIPE_PRICE_ID_PRO = "price_..."

# App URL（影響 Stripe redirect 等）
# Prod : https://minute-hk-app.streamlit.app
# UAT  : https://minute-hk-app-uat.streamlit.app（要喺 Streamlit Cloud 開時設定）
APP_URL = "https://minute-hk-app.streamlit.app"
